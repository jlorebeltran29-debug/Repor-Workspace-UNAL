<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> <%= title_contacts %> </title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <%- include('Partials/head') %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>
    <%- include('Partials/navegation') %>

    <!-- Creacion de formulario -->
    <div class="container min-vh-100 d-flex justify-content-center align-items-center py-5">
        <!-- Tarjeta de Bootstrap que contiene el formulario -->
        <div class="card contact-card text-white">

            <!-- Cabecera -->
            <div class="card-header text-center">
                <span class="header-icon"><i class="bi bi-chat-dots-fill"></i></span>
                <h3 class="mb-1">Escríbenos</h3>
                <p class="text-secondary mb-0">Cuéntanos qué necesitas y te respondemos lo antes posible.</p>
            </div>

            <!-- Cuerpo -->
            <div class="card-body p-4 p-md-5">

                <!-- Mensaje de éxito: desde la ruta res.render('contactos', { title_contacts: '...', enviado: true }) -->
                <% if (typeof enviado !== 'undefined' && enviado) { %>
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>¡Mensaje enviado! Pronto nos pondremos en contacto contigo.</div>
                    </div>
                <% } %>

                <form id="formContacto" action="/contactos" method="POST" class="needs-validation" novalidate>

                    <!-- Nombre -->
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre completo</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input type="text" id="nombre" name="nombre" class="form-control"
                                placeholder="Ej: Laura Gómez" minlength="3" maxlength="60" autocomplete="name" required>
                            <div class="invalid-feedback">Escribe tu nombre (mínimo 3 letras).</div>
                        </div>
                    </div>

                    <!-- Correo y teléfono -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <div class="input-group has-validation">
                                <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                                <input type="email" id="email" name="email" class="form-control"
                                    placeholder="tucorreo@ejemplo.com" autocomplete="email" required>
                                <div class="invalid-feedback">Ingresa un correo válido.</div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="telefono" class="form-label">Teléfono <small class="text-secondary">(opcional)</small></label>
                            <div class="input-group has-validation">
                                <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                                <input type="tel" id="telefono" name="telefono" class="form-control"
                                    placeholder="300 123 4567" pattern="[0-9 +()-]{7,15}" autocomplete="tel">
                                <div class="invalid-feedback">Número no válido.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Asunto -->
                    <div class="mb-3">
                        <label for="asunto" class="form-label">Asunto</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text"><i class="bi bi-tag-fill"></i></span>
                            <select id="asunto" name="asunto" class="form-select" required>
                                <option value="" selected disabled>Selecciona una opción</option>
                                <option value="reserva">Reservas</option>
                                <option value="pedido">Pedidos y domicilios</option>
                                <option value="eventos">Eventos y celebraciones</option>
                                <option value="sugerencia">Sugerencias</option>
                                <option value="reclamo">Quejas o reclamos</option>
                                <option value="otro">Otro</option>
                            </select>
                            <div class="invalid-feedback">Elige un asunto.</div>
                        </div>
                    </div>

                    <!-- Mensaje -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label for="mensaje" class="form-label">Mensaje</label>
                            <small class="text-secondary"><span id="contador">0</span>/500</small>
                        </div>
                        <textarea id="mensaje" name="mensaje" rows="4" maxlength="500" class="form-control"
                            placeholder="Escribe aquí tu mensaje..." minlength="10" required></textarea>
                        <div class="invalid-feedback">Cuéntanos un poco más (mínimo 10 caracteres).</div>
                    </div>

                    <!-- Campo trampa anti-spam -->
                    <div class="campo-trampa" aria-hidden="true">
                        <label for="sitio_web">No llenar este campo</label>
                        <input type="text" id="sitio_web" name="sitio_web" tabindex="-1" autocomplete="off">
                    </div>

                    <!-- Aceptar tratamiento de datos -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="acepto" name="acepto" required>
                        <label class="form-check-label small" for="acepto">
                            Acepto el tratamiento de mis datos personales para que me contacten.
                        </label>
                        <div class="invalid-feedback">Debes aceptar para poder enviar el formulario.</div>
                    </div>

                    <!-- Botones -->
                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="submit" id="btnEnviar" class="btn btn-warning btn-enviar flex-sm-grow-1">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-send-fill me-1"></i>
                            <span class="texto-boton">Enviar mensaje</span>
                        </button>
                        <button type="reset" class="btn btn-outline-light">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('Partials/footer') %>

    <script>
        (() => {
            const form = document.getElementById('formContacto');
            const mensaje = document.getElementById('mensaje');
            const contador = document.getElementById('contador');
            const btnEnviar = document.getElementById('btnEnviar');

            // Contador de caracteres
            mensaje.addEventListener('input', () => {
                contador.textContent = mensaje.value.length;
            });

            // Validación de Bootstrap + estado de carga
            form.addEventListener('submit', (e) => {
                // Si el campo trampa tiene algo, es un bot: no se envía
                if (document.getElementById('sitio_web').value !== '') {
                    e.preventDefault();
                    return;
                }

                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                } else {
                    btnEnviar.disabled = true;
                    btnEnviar.querySelector('.spinner-border').classList.remove('d-none');
                    btnEnviar.querySelector('.bi-send-fill').classList.add('d-none');
                    btnEnviar.querySelector('.texto-boton').textContent = 'Enviando...';
                }
                form.classList.add('was-validated');
            });

            // Al limpiar, se quitan los mensajes de validación y se reinicia el contador
            form.addEventListener('reset', () => {
                form.classList.remove('was-validated');
                contador.textContent = '0';
            });
        })();
    </script>
</body>
</html>