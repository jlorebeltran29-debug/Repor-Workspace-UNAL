<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title_login !== 'undefined' ? title_login : 'Login' %></title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Enlace entre el "head" y "navegation" -->
    <%- include('Partials/head') %>
</head>
<body class="login">

    <!-- Barra de Navegacion -->
    <%- include('Partials/navegation') %>

    <!-- Shift+alt+f Para organizar el codigo -->
    <!-- Contenedor principal unificado que centra todo vertical y horizontalmente -->
    <main class="container vh-100 d-flex flex-column justify-content-center align-items-center">
        <div class="login-card p-4 bg-white rounded shadow-lg" style="width: 100%; max-width: 400px;">

            <!-- Titulo de la vista -->
            <section class="text-center mb-4">
                <h1 class="h3 text-dark"> Iniciar de Sesión</h1>
            </section>

            <!-- Tarjeta de Login -->
            <div class="login-card p-4 bg-white rounded shadow-lg" style="width: 100%; max-width: 400px;">
                
                <!-- Formulario Principal -->
                <form  action="/login" method="post">
                    <% if (mensaje && mensaje !== "null" && mensaje !== "undefined") { %>
                    <div class="error"><%= mensaje %></div> <% } %>

                    <div class="mb-3">
                        <input type="text" class="form-control" name="usuario" placeholder="Usuario" required>
                    </div>

                    <div class="mb-3">
                        <input type="password" class="form-control" name="contrasena" placeholder="Contraseña" required>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mb-3">
                        <a href="/registro" class="btn btn-outline-dark w-50 rounded-pill"> Crear Usuario </a>
                        <button type="submit" class="btn btn-primary w-50 rounded-pill"> Ingresar </button>
                    </div>

                    <div>
                        <button type="reset" class="btn btn-info w-50 rounded-pill"> Limpiar </button>                    
                    </div>
                </form>

                <!-- Enlace de recuperacion -->
                <div class="links text-center mt-3 d-flex flex-column gap-1">
                    <a href="/recuperar-password" class="text-decoration-none">¿Olvidaste tu contraseña?</a>
                    <a href="/recordar-usuario" class="text-decoration-none">¿Olvidaste tu usuario?</a>
                </div>
            </div>
        </div>
    </main>
    <%- include('Partials/footer') %>
</body>
</html>